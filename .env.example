# Jill intelligence uses the local OpenAI-compatible model.
LLM_PROVIDER=local
LLM_BASE_URL=http://100.121.222.58:8082/v1
LLM_MODEL=qwen3.6:27b-64k

# Local persistent state.
SQLITE_PATH=data/jill.sqlite

# AgentMail runs live when AGENTMAIL_API_KEY is set; otherwise email falls back to simulation.
AGENTMAIL_API_KEY=

# Optional live AgentMail settings.
AGENTMAIL_INBOX_ID=bsl-procurement@agentmail.to
AGENTMAIL_INBOX_ADDRESS=bsl-procurement@agentmail.to
AGENTMAIL_WEBHOOK_SECRET=

# Optional: force email simulation even when a key is present.
# DEMO_MODE=simulation
